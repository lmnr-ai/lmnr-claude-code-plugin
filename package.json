{
  "name": "lmnr-claude-code-plugin",
  "version": "0.1.0",
  "description": "Laminar observability plugin for Claude Code",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/hook.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/hook.cjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
